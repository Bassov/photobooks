{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photobooks",
  // Workers Free: assets-only SPA (static asset requests are free/unlimited).
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
