{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photobooks",
  // Workers Free: static asset requests are free/unlimited. The script only
  // runs for `run_worker_first` paths: the Cloudflare API relay `/api/cf/*`.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": true,
  // Required for `wrangler preview` / Workers Builds preview deploys.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/cf/*"],
  },
  // Off: invocation logs record request metadata, and the relay carries users'
  // setup tokens in `Authorization` (Owner, Q-16: nothing stored or logged).
  "observability": {
    "enabled": false,
  },
}
