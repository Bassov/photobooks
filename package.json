{
  "name": "photobooks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:quiet": "node scripts/check.mjs --run unit -- pnpm exec vitest run --reporter=dot --silent",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:e2e": "node scripts/merge-e2e-coverage.mjs",
    "bench": "vitest bench",
    "test:e2e": "node scripts/with-playwright-env.mjs playwright test --project=chromium --workers=1",
    "test:e2e:flaky": "node scripts/with-playwright-env.mjs playwright test --project=flaky --workers=1",
    "test:e2e:quiet": "node scripts/with-playwright-env.mjs playwright test --project=chromium --workers=1 --reporter=dot",
    "test:e2e:changed:quiet": "node scripts/check.mjs --run e2e-changed -- node scripts/e2e-changed-quiet-cli.mjs",
    "perf": "PERF_HARD_FRAME_PACING=1 node scripts/with-playwright-env.mjs playwright test --project=chromium e2e/filmstrip.spec.ts e2e/spread-view.spec.ts e2e/drag-place.spec.ts e2e/drag-swap.spec.ts -g \"frame-budget\"",
    "test:lhci": "node scripts/with-playwright-env.mjs pnpm build && node scripts/with-playwright-env.mjs lhci autorun --config=lighthouserc.cjs",
    "stryker": "stryker run",
    "stryker:diff": "node scripts/check.mjs --run stryker-diff -- node scripts/stryker-diff.mjs",
    "mutation-scope": "node scripts/check-mutation-scope.mjs",
    "gate-values": "node scripts/check-gate-values.mjs",
    "codecov-yml": "node scripts/codecov-yml-cli.mjs",
    "git-test-isolation": "node scripts/check-no-direct-git-in-tests.mjs",
    "roadmap": "node scripts/roadmap.mjs",
    "agent": "node scripts/agent-cli.mjs",
    "audit:ci": "pnpm audit --audit-level=high --prod",
    "check": "node scripts/check.mjs",
    "verify:fast": "pnpm check",
    "verify:fast:quiet": "pnpm check",
    "verify": "pnpm check && pnpm test:e2e",
    "playwright:libs": "node scripts/bootstrap-playwright-libs.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "2.0.1",
    "@eslint/js": "^9.39.2",
    "@fast-check/vitest": "^0.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.1",
    "jpeg-js": "^0.4.4",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "nyc": "18.0.0",
    "oxc-transform-react": "^0.152.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "esbuild",
      "workerd",
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "8"
      }
    },
    "patchedDependencies": {
      "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
    }
  }
}
