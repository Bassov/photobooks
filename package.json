{
  "name": "photobooks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "test:e2e": "node scripts/with-playwright-env.mjs playwright test",
    "test:lhci": "node scripts/with-playwright-env.mjs pnpm build && node scripts/with-playwright-env.mjs lhci autorun --config=lighthouserc.cjs",
    "stryker": "stryker run",
    "stryker:diff": "node scripts/stryker-diff.mjs",
    "audit:ci": "pnpm audit --audit-level=high --prod",
    "verify:fast": "pnpm typecheck && pnpm lint && pnpm deps && pnpm knip && pnpm test",
    "verify": "pnpm verify:fast && pnpm test:e2e",
    "playwright:libs": "node scripts/bootstrap-playwright-libs.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@fast-check/vitest": "^0.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.1",
    "jpeg-js": "^0.4.4",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "esbuild",
      "workerd",
      "sharp"
    ],
    "patchedDependencies": {
      "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
    }
  }
}
