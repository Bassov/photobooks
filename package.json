{
  "name": "photobooks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm uikit:build",
    "preview": "vite preview",
    "uikit:dev": "pnpm --filter photobooks-ui-kit dev",
    "uikit:build": "pnpm --filter photobooks-ui-kit build",
    "uikit:typecheck": "pnpm --filter photobooks-ui-kit typecheck",
    "uikit:qa:quick": "ts-rig-ci with-playwright-env pnpm --filter photobooks-ui-kit qa:quick",
    "assert:no-uikit-in-app": "node scripts/assert-no-uikit-in-app-bundle.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:quiet": "ts-rig-check --run unit -- pnpm exec vitest run --reporter=dot --silent",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:e2e": "ts-rig-ci merge-e2e-coverage",
    "bench": "vitest bench",
    "test:e2e": "ts-rig-ci with-playwright-env playwright test --project=chromium --workers=1",
    "test:e2e:flaky": "ts-rig-ci with-playwright-env playwright test --project=flaky --workers=1",
    "test:e2e:quiet": "ts-rig-ci with-playwright-env playwright test --project=chromium --workers=1 --reporter=dot",
    "test:e2e:changed:quiet": "ts-rig-check --run e2e-changed -- ts-rig-gate e2e-changed",
    "perf": "PERF_HARD_FRAME_PACING=1 ts-rig-ci with-playwright-env playwright test --project=chromium e2e/filmstrip.spec.ts e2e/spread-view.spec.ts e2e/drag-place.spec.ts e2e/drag-swap.spec.ts -g \"frame-budget\"",
    "test:lhci": "ts-rig-ci with-playwright-env pnpm build && ts-rig-ci with-playwright-env lhci autorun --config=lighthouserc.cjs",
    "stryker": "stryker run",
    "stryker:diff": "ts-rig-check --run stryker-diff -- ts-rig-gate stryker-diff",
    "mutation-scope": "ts-rig-gate mutation-scope",
    "gate-values": "ts-rig-gate gate-values",
    "openspec-budget": "ts-rig-gate openspec-budget",
    "codecov-yml": "ts-rig-gate codecov-yml",
    "roadmap": "roadmap",
    "agent": "agent",
    "audit:ci": "pnpm audit --audit-level=high --prod",
    "check": "ts-rig-check",
    "quality:self-check": "ts-rig-gate quality-self-check",
    "patch-coverage": "ts-rig-gate patch-coverage",
    "verify:fast": "pnpm check",
    "verify:fast:quiet": "pnpm check",
    "verify": "pnpm check && pnpm test:e2e",
    "playwright:libs": "ts-rig-ci playwright-libs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@albasov/ts-agent-rig": "github:Bassov/ts-agent-rig#v0.2.4",
    "@codecov/vite-plugin": "2.0.1",
    "@eslint/js": "^9.39.2",
    "@fast-check/vitest": "^0.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "jpeg-js": "^0.4.4",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "nyc": "18.0.0",
    "oxc-transform-react": "^0.152.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "esbuild",
      "workerd",
      "sharp",
      "@albasov/ts-agent-rig"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "8"
      }
    },
    "patchedDependencies": {
      "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
    }
  }
}
