{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/core/index.ts",
    "src/project/index.ts",
    "src/assets/index.ts",
    "src/photo/photo.worker.ts!",
    "src/derivatives/lab/main.ts",
    "src/derivatives/lab/lab.worker.ts",
    "src/worker/index.ts!",
    "e2e/**/*.ts",
    "e2e/fixtures/*.{mjs,js}",
    "scripts/**/*.{mjs,js,cjs}",
    "lighthouserc.cjs!"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.{ts,mjs,js}",
    "scripts/**/*.{mjs,js,cjs}"
  ],
  // The vendored three r170 types: knip resolves the `.js` import, not its
  // hand-typed `.d.ts`. Drop when site-final-home wires the GL book in.
  "ignore": ["src/site/book/gl/vendor/three.module.min.d.ts"],
  "ignoreWorkspaces": ["uikit"],
  "ignoreBinaries": ["apt-get", "dpkg-deb"],
  "ignoreDependencies": [
    "@lhci/cli",
    "fast-check",
    "nyc",
    "@albasov/ts-agent-rig",
    "tailwindcss",
    // Added early by the Owner (Q-14); drop when pdf-captions imports it.
    "@pdf-lib/fontkit"
  ],
  "ignoreIssues": {
    "src/core/index.ts": ["types", "exports"],
    "src/project/index.ts": ["types", "exports"],
    "src/assets/index.ts": ["types", "exports"],
    "src/perf/exposePerf.ts": ["types"],
    "src/photo/exifSchema.ts": ["types"]
  }
}
