{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/core/index.ts",
    "src/project/index.ts",
    "src/assets/index.ts",
    "src/photo/photo.worker.ts!",
    "e2e/**/*.ts",
    "e2e/fixtures/*.{mjs,js}",
    "scripts/**/*.{mjs,js,cjs}",
    "lighthouserc.cjs!"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.{ts,mjs,js}",
    "scripts/**/*.{mjs,js,cjs}"
  ],
  "ignoreWorkspaces": ["uikit"],
  "ignoreBinaries": ["apt-get", "dpkg-deb"],
  "ignoreDependencies": [
    "@lhci/cli",
    "fast-check",
    "nyc",
    "@albasov/ts-agent-rig",
    "tailwindcss"
  ],
  "ignoreIssues": {
    "src/core/index.ts": ["types", "exports"],
    "src/project/index.ts": ["types", "exports"],
    "src/assets/index.ts": ["types", "exports"],
    "src/perf/exposePerf.ts": ["types"],
    "src/photo/exifSchema.ts": ["types"]
  }
}
