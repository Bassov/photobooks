{
  "permissions": {
    "allow": [
      "Shell(pnpm)",
      "Shell(node)",
      "Shell(npx)",
      "Shell(bash)",
      "Shell(source)",
      "Shell(tmux)",
      "Shell(git:add*)",
      "Shell(git:commit*)",
      "Shell(git:push*)",
      "Shell(git:checkout*)",
      "Shell(git:switch*)",
      "Shell(git:pull*)",
      "Shell(git:fetch*)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:rm*)",
      "Shell(git:mv*)",
      "Shell(git:restore*)",
      "Shell(git:branch*)",
      "Shell(git:stash*)",
      "Shell(git:rev-parse*)",
      "Shell(git:merge-base*)",
      "Shell(gh:pr create*)",
      "Shell(gh:pr view*)",
      "Shell(gh:pr edit*)",
      "Shell(gh:pr comment*)",
      "Shell(gh:pr checks*)",
      "Shell(gh:pr diff*)",
      "Shell(gh:run view*)",
      "Shell(gh:run list*)",
      "Shell(gh:run watch*)",
      "Shell(gh:issue view*)",
      "Shell(ls)",
      "Shell(cat)",
      "Shell(rg)",
      "Shell(head)",
      "Shell(tail)",
      "Shell(wc)",
      "Shell(jq)",
      "Shell(mkdir)",
      "Shell(cp)",
      "Shell(mv)",
      "Shell(rm)",
      "Read(**)",
      "Write(**)"
    ],
    "deny": [
      "Shell(rm:-rf /*)",
      "Shell(rm:-rf ~*)",
      "Shell(rm:-rf ..*)",
      "Shell(git:push --force*)",
      "Shell(git:push -f*)",
      "Shell(git:push origin main*)",
      "Shell(git:push origin HEAD:main*)",
      "Shell(git:reset --hard*)",
      "Shell(gh:pr merge*)",
      "Shell(gh:repo*)",
      "Shell(gh:api*)",
      "Shell(sudo)",
      "Write(.env*)",
      "Write(.git/**)"
    ]
  }
}
