{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "900000",
    "BASH_MAX_TIMEOUT_MS": "3600000"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(source scripts/agent-env.sh)",
      "Bash(. scripts/agent-env.sh)",
      "Bash(node scripts/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git restore *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git merge origin/main*)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh run rerun *)",
      "Bash(gh issue view *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(echo *)",
      "Bash(git check-ignore *)",
      "Bash(git worktree list*)",
      "Bash(VITE_E2E=1 pnpm *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)"
    ],
    "deny": [
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(zsh *)",
      "Bash(npx *)",
      "Bash(tmux *)",
      "Bash(node -e *)",
      "Bash(node --eval *)",
      "Bash(node -p *)",
      "Bash(node -i *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm exec * -c *)",
      "Bash(pnpm node *)",
      "Bash(pnpm create *)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit *--amend*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *:main*)",
      "Bash(git push * main*)",
      "Bash(git push *--delete*)",
      "Bash(git reset --hard*)",
      "Bash(git restore .*)",
      "Bash(git restore *--source*)",
      "Bash(git checkout -- .*)",
      "Bash(git checkout .*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D*)",
      "Bash(git clean*)",
      "Bash(rm *-rf /*)",
      "Bash(rm *-fr /*)",
      "Bash(rm *-rf ~*)",
      "Bash(rm *-fr ~*)",
      "Bash(rm *-rf ..*)",
      "Bash(rm *-fr ..*)",
      "Bash(rm *.git*)",
      "Bash(rm *.env*)",
      "Bash(rm *.dev.vars*)",
      "Bash(mv *.env*)",
      "Bash(mv *.dev.vars*)",
      "Bash(mv *.git*)",
      "Bash(cp *.env*)",
      "Bash(cp *.dev.vars*)",
      "Bash(cp *.git*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh repo*)",
      "Bash(gh api*)",
      "Bash(sudo *)",
      "Read(**/.env*)",
      "Read(**/.dev.vars*)",
      "Edit(**/.env*)",
      "Edit(**/.dev.vars*)",
      "Edit(.git/**)",
      "Bash(sed -i*)",
      "Bash(sed * -i*)",
      "Bash(sed --in-place*)",
      "Bash(sed * --in-place*)",
      "Bash(sed -ni*)",
      "Bash(sed -ei*)",
      "Bash(sed -Ei*)",
      "Bash(sed -ri*)",
      "Bash(sed -si*)",
      "Bash(sed -ui*)",
      "Bash(sed -zi*)",
      "Bash(sed -li*)",
      "Bash(sed -bi*)",
      "Bash(sed * -ni*)",
      "Bash(sed * -ei*)",
      "Bash(sed * -Ei*)",
      "Bash(sed * -ri*)",
      "Bash(sed * -si*)",
      "Bash(sed * -ui*)",
      "Bash(sed * -zi*)",
      "Bash(sed * -li*)",
      "Bash(sed * -bi*)",
      "Bash(awk *system*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let s='';process.stdin.on('data',c=>s+=c).on('end',()=>{const f=JSON.parse(s).tool_input?.file_path;if(f)require('child_process').spawnSync(process.env.CLAUDE_PROJECT_DIR+'/node_modules/.bin/prettier',['--write','--ignore-unknown','--log-level=silent',f],{stdio:'ignore'})})\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
