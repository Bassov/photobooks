{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vite.config.ts",
    "related": true
  },
  "mutate": [
    "src/lib/**/*.ts",
    "src/core/**/*.ts",
    "!src/core/index.ts",
    "!src/core/**/testing/**",
    "src/render/frameBox.ts",
    "src/editor/bookStore.ts",
    "src/editor/importPhotos.ts",
    "src/editor/pasteboardWindow.ts",
    "src/editor/thumbCache.ts",
    "src/photo/aspectRatio.ts",
    "src/photo/formatBytes.ts",
    "src/photo/mime.ts",
    "src/photo/normalizeOrientation.ts",
    "src/photo/exifOrientationLabel.ts",
    "src/photo/processPhoto.ts",
    "src/photo/pickPhoto.ts",
    "src/photo/pickPhotos.ts",
    "src/photo/assetPool.ts",
    "src/photo/objectUrlLru.ts",
    "!src/**/*.{test,spec}.{ts,tsx}",
    "!src/**/*.{bench,benchmark}.{ts,tsx}"
  ],
  "ignorePatterns": [
    ".local_dev",
    "dist",
    "coverage",
    "reports",
    "test-results",
    "playwright-report",
    ".lighthouseci",
    ".stryker-tmp",
    "e2e",
    "C:*"
  ],
  "reporters": ["clear-text", "html", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },

  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "ignoreStatic": true
}
