{
  "coverage": {
    "statements": 80,
    "branches": 80,
    "functions": 80,
    "lines": 80
  },
  "stryker": {
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    },
    "diffThresholds": {
      "high": 90,
      "low": 85,
      "break": 85
    }
  },
  "mutation": {
    "disableBudget": 0,
    "temporaryExcludes": [
      {
        "path": "src/editor/projectSession.ts",
        "until": "project-session-mutation"
      },
      {
        "path": "src/editor/usePasteboardCamera.ts",
        "until": "mutation-reinclude-camera"
      },
      {
        "path": "src/editor/EditorShell.tsx",
        "until": "editor-shell-mutation"
      },
      {
        "path": "src/editor/HomeScreen.tsx",
        "until": "home-app-mutation"
      },
      {
        "path": "src/App.tsx",
        "until": "home-app-mutation"
      },
      {
        "path": "src/editor/previewAspect.ts",
        "until": "mutation-reinclude-small"
      },
      {
        "path": "src/editor/upgradeSessionAssets.ts",
        "until": "mutation-reinclude-small"
      },
      {
        "path": "src/project/session/idb.ts",
        "until": "session-idb-locks-mutation"
      },
      {
        "path": "src/project/session/locks.ts",
        "until": "session-idb-locks-mutation"
      },
      {
        "path": "src/assets/hash.worker.ts",
        "until": "mutation-reinclude-small"
      },
      {
        "path": "src/photo/photo.worker.ts",
        "until": "mutation-reinclude-small"
      }
    ]
  },
  "lighthouse": {
    "numberOfRuns": 1,
    "assertions": {
      "performance-budget": "error"
    },
    "budgets": [
      {
        "path": "/*",
        "resourceSizes": [
          {
            "resourceType": "document",
            "budget": 20
          },
          {
            "resourceType": "script",
            "budget": 350
          },
          {
            "resourceType": "stylesheet",
            "budget": 50
          },
          {
            "resourceType": "total",
            "budget": 500
          }
        ],
        "resourceCounts": [
          {
            "resourceType": "third-party",
            "budget": 0
          }
        ]
      }
    ]
  },
  "playwright": {
    "retries": 0,
    "flakyRetries": 2
  },
  "e2e": {
    "burnInDefault": 10,
    "flakySpecs": []
  },
  "requiredCheckJobs": [
    "checks",
    "integration",
    "lighthouse",
    "stryker-diff",
    "gitleaks",
    "dependency-review",
    "analyze"
  ],
  "agentRules": {
    "budgets": [
      {
        "path": ".cursor/agents/openspec-design-reviewer.md",
        "maxLines": 11,
        "maxChars": 267
      },
      {
        "path": ".cursor/agents/openspec-implementation-reviewer.md",
        "maxLines": 60,
        "maxChars": 5046
      },
      {
        "path": ".cursor/agents/openspec-planning-reviewer.md",
        "maxLines": 70,
        "maxChars": 4509
      },
      {
        "path": ".cursor/agents/openspec-proposal-reviewer.md",
        "maxLines": 11,
        "maxChars": 269
      },
      {
        "path": ".cursor/commands/next-roadmap-item.md",
        "maxLines": 77,
        "maxChars": 5186
      },
      {
        "path": ".cursor/rules/architecture.mdc",
        "maxLines": 13,
        "maxChars": 673
      },
      {
        "path": ".cursor/rules/data-model.mdc",
        "maxLines": 17,
        "maxChars": 1366
      },
      {
        "path": ".cursor/rules/git-finish.mdc",
        "maxLines": 19,
        "maxChars": 2532
      },
      {
        "path": ".cursor/rules/overview.mdc",
        "maxLines": 15,
        "maxChars": 557
      },
      {
        "path": ".cursor/rules/testing.mdc",
        "maxLines": 22,
        "maxChars": 1061
      },
      {
        "path": "AGENTS.md",
        "maxLines": 81,
        "maxChars": 6094
      },
      {
        "path": "openspec/config.yaml",
        "maxLines": 120,
        "maxChars": 15809
      }
    ]
  }
}
